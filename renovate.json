{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>LizardByte/.github:renovate-config"
  ],
  "customManagers": [
    {
      "description": "Track the untagged Xbox SDL3 port by its branch commit",
      "customType": "regex",
      "managerFilePatterns": ["/^package-lock\\.cmake$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+# ref=(?<currentValue>\\S+)\\s+set\\(NXDK_SDL3_COMMIT\\s+(?<currentDigest>[a-f0-9]{40})\\s*\\)"
      ]
    }
  ],
  "forkProcessing": "enabled"
}
