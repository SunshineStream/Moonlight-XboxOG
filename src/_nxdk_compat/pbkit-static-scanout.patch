+    // Keep the current CPU page visible until PVIDEO has a frame to display.
+    if (preserve_scanout)
+        pb_debug_screen_active=1;
+    else
+        pb_show_front_screen();
 
     pb_shutdown_registration.NotificationRoutine = pb_shutdown_notification_routine;
     pb_shutdown_registration.Priority = 0;
@@ -3287,5 +3291,15 @@ int pb_init(void)
     return 0;
 }
 
+int pb_init(void)
+{
+    return pb_init_with_scanout(false, false);
+}
+
+int moonlight_pb_init_pvideo_scanout(bool static_scanout)
+{
+    return pb_init_with_scanout(static_scanout, true);
+}
