+int pb_init(void)
+{
+    return pb_init_with_scanout(false, false);
+}
+
+int sunshine_pb_init_pvideo_scanout(bool static_scanout)
+{
+    return pb_init_with_scanout(static_scanout, true);
+}
+
+/**
+ * @brief Disable depth and stencil access after the streaming background has been cleared.
+ *
+ * Keep ownership in pb_DepthStencilAddr until the queued commands have completed.
+ */
+void sunshine_pb_detach_depth_stencil(void)
+{
+    pb_DSAddr=0;
+    pb_target_back_buffer();
+
+    uint32_t *p=pb_begin();
+    p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_DEPTH_WRITE_ENABLE,0);
+    p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_CULL_ENABLE,0);
+    pb_end(p);
+}
+
+/**
+ * @brief Free the detached depth allocation after the caller has waited for GPU idle.
+ */
+void sunshine_pb_release_detached_depth_stencil(void)
+{
+    if (pb_DSAddr != 0 || pb_DepthStencilAddr == 0)
+        return;
+
+    pb_release_tile(1,1);
+    MmFreeContiguousMemory((PVOID)pb_DepthStencilAddr);
+    pb_DepthStencilAddr=0;
+    pb_DSSize=0;
+}
+
 static NTAPI VOID pb_shutdown_notification_routine (PHAL_SHUTDOWN_REGISTRATION ShutdownRegistration)
 {
