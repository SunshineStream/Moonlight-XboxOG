diff --git a/lib/hal/video.c b/lib/hal/video.c
--- a/lib/hal/video.c
+++ b/lib/hal/video.c
@@ -50,4 +50,5 @@
 
 static unsigned char*	framebufferMemory = NULL;
+static int			framebufferCapacity = 0; ///< Bytes reserved for CPU scanout.
 static unsigned char*	_fb = NULL;
 static DWORD			dwEncoderSettings 	= 0;
@@ -323,4 +324,11 @@
 }
 
+/**
+ * @brief Configure the display while retaining the CPU scanout allocation across mode changes.
+ * @param dwMode Kernel display mode token.
+ * @param width Visible width in pixels.
+ * @param height Visible height in pixels.
+ * @param bpp Framebuffer color depth.
+ */
 void XVideoInit(DWORD dwMode, int width, int height, int bpp)
 {
@@ -358,13 +366,28 @@
 	}
 
-	if (framebufferMemory != NULL) {
-		MmFreeContiguousMemory(framebufferMemory);
-	}
-	framebufferMemory = MmAllocateContiguousMemoryEx(screenSize,
-	                                                 0x00000000, 0x7FFFFFFF,
-	                                                 0x1000,
-	                                                 PAGE_READWRITE |
-	                                                 PAGE_WRITECOMBINE);
-	assert(framebufferMemory != NULL);
+	// Keep CPU scanout at an address that cannot be reused by pbkit color
+	// buffers. xemu's display can select a cached GPU surface by its VRAM
+	// range after the surface has been freed by the guest.
+	if (framebufferCapacity < screenSize) {
+		if (framebufferMemory != NULL) {
+			MmFreeContiguousMemory(framebufferMemory);
+		}
+		int capacity = screenSize;
+		const DWORD encoder = XVideoGetEncoderSettings();
+		const int hdScanoutSize = 1920 * 1080 * 2;
+		if ((encoder & (VIDEO_ADAPTER_MASK | VIDEO_MODE_1080I)) == (AV_PACK_HDTV | VIDEO_MODE_1080I) &&
+		    capacity < hdScanoutSize) {
+			capacity = hdScanoutSize;
+		}
+		framebufferMemory = MmAllocateContiguousMemoryEx(capacity, 0, 0x7FFFFFFF, 0x1000,
+		                                                 PAGE_READWRITE | PAGE_WRITECOMBINE);
+		if (framebufferMemory == NULL && capacity > screenSize) {
+			capacity = screenSize;
+			framebufferMemory = MmAllocateContiguousMemoryEx(capacity, 0, 0x7FFFFFFF, 0x1000,
+			                                                 PAGE_READWRITE | PAGE_WRITECOMBINE);
+		}
+		assert(framebufferMemory != NULL);
+		framebufferCapacity = capacity;
+	}
 	memset(framebufferMemory, 0x00, screenSize);
 	asm __volatile__("sfence");
